# The usher's steward as a service. The shape is evo's: the name of the
# unit, the three directories and the first block of protections are
# those evo-core's reference unit carries. What a distribution chooses is
# chosen here: the program, the account it runs as, the listener, and the
# protections under the second heading.
#
# What is to differ on one machine goes into a drop-in
# (`systemctl edit evo`), which a newer package leaves alone.

[Unit]
Description=unifi-evo-usher: the evo steward with the usher's plugins
Documentation=https://github.com/foonerd/unifi-evo-usher
After=network.target

[Service]
Type=simple
ExecStart=/opt/evo/bin/evo-usher-steward

# The account the package makes for it. It owns what the steward keeps
# and nothing else.
User=evo
Group=evo

# The face, to every browser that reaches the machine. A caller who has
# not signed in is refused everything but the face and the way to sign
# in. For a machine that is its own screen:
# EVO_HTTPS_LISTEN_ADDR=127.0.0.1:8443
Environment=EVO_HTTPS_LISTEN_ADDR=0.0.0.0:8443
Environment=EVO_HTTPS_STATIC_DIR=/opt/evo/ui

# How strict the usher is: its administrator's choice. At the ordinary
# level, `standard`, whoever opens a new unit first sets it up, with a
# name and a password. At `extended`, setting it up takes the code below
# as well, passwords are longer, sessions shorter, and no browser is
# kept signed in. Set in a drop-in (`sudo systemctl edit evo`), or here:
#Environment=USHER_SECURITY=extended

# What the place the unit serves is called, and the time zone it keeps,
# by its name, as Europe/Warsaw. A unit goes by these until an
# administrator saves a name and a time zone on the page Site; what is
# saved there stands from then on. Set in a drop-in, or here:
#Environment="USHER_SITE_NAME=Parish Hall"
#Environment=USHER_TIME_ZONE=Europe/Warsaw

# The code a unit of the extended level is set up with. The steward makes
# one where the file is not there, and the directory is new at every
# start: so is the code. It is read with `sudo cat /run/evo/unit-code`.
# At the ordinary level none is made and none is asked. The variable's
# name is evo's.
Environment=EVO_PAIR_PRESEED_FILE=/run/evo/unit-code

# Where the steward keeps what it is believed by, and the usher its
# people beside it. It is evo's own default, named so that everything
# that reads or writes there goes by the one name.
Environment=EVO_HTTPS_STATE_DIR=/var/lib/evo/state

Restart=on-failure
RestartSec=5s

# Stopping is the steward's to drive: it alone is told, and what it
# started is ended with it only when the time is up.
KillMode=mixed
TimeoutStopSec=30s

# /run/evo for the client socket, /var/lib/evo for what the steward
# keeps, /etc/evo for its configuration, which it only reads.
RuntimeDirectory=evo
RuntimeDirectoryMode=0755
StateDirectory=evo
StateDirectoryMode=0750
ConfigurationDirectory=evo
ConfigurationDirectoryMode=0755
UMask=0077

# evo-core's tested baseline.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes

# The usher's own: a steward that hands out vouchers needs no privilege,
# no device, and no more of the kernel than a network service does.
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
