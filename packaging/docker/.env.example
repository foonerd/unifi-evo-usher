# The values of one site, for the Compose files of the usher. Copy this
# file to `.env` beside the Compose file that is run and set what
# differs: Compose reads `.env` from the directory of the first file it
# is given. A line left as a comment leaves the default, which is the
# value shown. A value given in the shell goes before this file.

# The version of the usher to run. There is no "latest", and no default:
# a unit runs the version it is told to. Every Compose file needs it.
USHER_VERSION=

# The image, where it is not the one the repository's releases publish.
#USHER_IMAGE=ghcr.io/foonerd/unifi-evo-usher

# What the container is called on this machine, and what the unit calls
# itself.
#USHER_NAME=usher

# What the place the unit serves is called, as it stands in the bar, on
# the form people sign in by and above a voucher shown to a guest; and
# the time zone it keeps, by its name in the time zone database, as
# Europe/Warsaw, in which every screen shows a time. A unit goes by
# these until an administrator saves a name and a time zone on the page
# Site; what is saved there stands from then on. Left empty, the unit
# has no name of its own, and each screen shows a time as its browser
# keeps it.
#USHER_SITE_NAME=
#USHER_TIME_ZONE=

# The language the unit speaks, by its tag: en for English, de for
# German. A unit goes by it until an administrator saves a language on
# the page Site. A browser is spoken to in its own language where the
# usher speaks it, and in this one where it does not; whoever is at a
# screen can pick another there. Left empty, it is English.
#USHER_LANGUAGE=

# packaging/docker/compose.yaml, the unit by itself: the address and the
# port of this machine its face is published on. 0.0.0.0 is every
# address; 127.0.0.1 keeps it to this machine, for a proxy on the same
# one.
#USHER_ADDRESS=0.0.0.0
#USHER_PORT=8443

# packaging/docker/extended.yaml, the extended level of security: the
# file that holds the unit's code, readable by the account 10001.
#USHER_CODE=./unit-code

# packaging/proxy/*/compose.yaml, the unit behind a proxy: the site's
# certificate and its key, the unit's own authority as it was taken from
# the unit, and the address and the port the proxy is published on.
#SITE_CERT=./site.crt
#SITE_KEY=./site.key
#USHER_AUTHORITY=./unit-ca.crt
#SITE_ADDRESS=0.0.0.0
#SITE_PORT=443
